<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Record: the hardened runtime blocks the microphone without this
	     (the call's audio and the screen come through ScreenCaptureKit,
	     which needs the user's permission, not an entitlement). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
