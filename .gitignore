# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Swift / macOS app
macos/.build/
macos/build/
# Vendored whisper.cpp build products. The submodule itself is tracked; these
# are regenerated by scripts/build-whisper.sh.
macos/vendor/build/
macos/vendor/install/
# Vendored sherpa-onnx dylibs, copied from the Python distribution by
# scripts/build-sherpa.sh (models stay under ~/.cache/whiz).
macos/vendor/sherpa-onnx/
*.xcodeproj/
*.xcworkspace/
# Per-user Xcode state written into the package when it is opened in the IDE.
.swiftpm/xcode/xcuserdata/
macos/.swiftpm/

# Virtualenvs
.venv/
venv/
env/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
# clangd symbol-index caches (Zed / sourcekit-lsp write .cache/clangd
# under whatever project root they detect, e.g. macos/vendor/).
.cache/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# whiz local config (uncomment to ignore)
# ~/.config/whiz/uv.lock

# bearing — generated local state (safe to remove via bearing-uninstall)
.bearing/.gitnexus-*
.bearing/.bearing-*
.bearing/.task-core.md
.bearing/task-cores/
*.bearing-backup
.bearing/manifest.json
.bearing/hooks.local.json
.gitnexus/
.tmp-agent/
.bearing/gitnexus-api-profile.json
docs/ARCHITECTURE.gitnexus.md
.agents/skills/
# Per-runtime mirrored skills (symlinked/mirrored from .bearing/skills by the
# teaching bundle; regenerated on bearing:sync-teaching).
.claude/
# --- end bearing ---
