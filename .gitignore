# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Swift / macOS app
macos/.build/
macos/build/
# Pre-split residue: whisper.cpp was vendored here for the dictation app, which
# moved to mynah with its submodule. Nothing in whiz builds or reads it; an old
# checkout can still hold ~60 MB of it, which `git add -A` must not pick up.
macos/vendor/
*.xcodeproj/
*.xcworkspace/
# Per-user Xcode state written into the package when it is opened in the IDE.
.swiftpm/xcode/xcuserdata/
macos/.swiftpm/

# Virtualenvs
.venv/
venv/
env/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# whiz local config (uncomment to ignore)
# ~/.config/whiz/uv.lock

# bearing — generated local state (safe to remove via bearing-uninstall)
.bearing/.gitnexus-*
.bearing/.bearing-*
.bearing/.task-core.md
.bearing/task-cores/
*.bearing-backup
.bearing/manifest.json
.bearing/hooks.local.json
.gitnexus/
.tmp-agent/
.bearing/gitnexus-api-profile.json
docs/ARCHITECTURE.gitnexus.md
.agents/skills/
# --- end bearing ---
